{
  "name": "@epochly/relay-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Relay-profile cel-js evaluator and RFC 8785 JCS canonical encoder. TypeScript mirror of packages/contracts/ (Python). VAL-W6-010..014.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./src/_wasm/relay_cel_wasm.wasm"
  },
  "files": [
    "dist",
    "src",
    "src/_wasm/relay_cel_wasm.wasm",
    "src/_wasm/relay-cel-wasm.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ignore-pattern test/fixtures/floating-promise-sample.ts && tsc -p tsconfig.json --noEmit",
    "lint:eslint": "eslint . --ignore-pattern test/fixtures/floating-promise-sample.ts",
    "test": "npm run build && vitest run --reporter=verbose"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "cel-js": "0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.1.0"
  }
}
