{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.epochly.com/schemas/x-relay/incident-monitoring-event.v1.json",
  "title": "x-relay/incident-monitoring-event",
  "description": "Relay Incident extension for ACEF bundles. Spec table line 868: include detection time, severity, linked runs, remediation, notification evidence. Generated under bundle.namespaces['x-relay']['incident-monitoring-event'].",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "severity",
    "detected_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "x-relay.incident-monitoring-event.v1"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "severity": {
      "type": "string",
      "enum": ["sev1", "sev2", "sev3", "sev4"],
      "description": "Per spec Q.1 severity definitions."
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "default": []
    },
    "remediation_summary_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the structured remediation summary."
    },
    "notification_evidence_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of provider/authority notification evidence per AI Act Article 26."
    },
    "status": {
      "type": "string",
      "enum": ["open", "investigating", "remediated", "closed"]
    }
  }
}
