# Relay local-compose environment template.
#
# Copy this file to `.env` in the same directory and edit values to taste:
#
#     cp .env.example .env
#
# Compose auto-loads `.env` from the working directory; values here are
# referenced via ${VAR_NAME:-default} substitutions in `docker-compose.yml`.
# Variables not listed here use their built-in defaults documented inline
# in the Compose file.

# Sidecar uvicorn log level. Default: warning. Set to "info" for routine
# debugging or "debug" for deep tracing. Mirrors the
# RELAY_SIDECAR_LOG_LEVEL env consumed at
# apps/local-sidecar/relay_sidecar/runtime.py.
RELAY_SIDECAR_LOG_LEVEL=warning
