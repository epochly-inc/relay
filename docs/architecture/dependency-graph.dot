digraph relay_deps {
  rankdir=LR;
  node [shape=box];
  "acef";
  "cli";
  "contracts";
  "contracts-typescript";
  "evals";
  "explain";
  "gate";
  "local-sidecar";
  "replay-proxy";
  "replay-sandbox-protocol";
  "schemas";
  "sdk-python";
  "sdk-typescript";
  "sdk-typescript-sidecar-bundle";
  "verifier";
  "verifier-typescript";
  "cli" -> "acef";
  "cli" -> "contracts";
  "cli" -> "local-sidecar";
  "cli" -> "replay-proxy";
  "cli" -> "schemas";
  "cli" -> "sdk-python";
  "cli" -> "verifier";
  "contracts" -> "schemas";
  "evals" -> "contracts";
  "evals" -> "schemas";
  "explain" -> "schemas";
  "gate" -> "contracts";
  "gate" -> "local-sidecar";
  "gate" -> "schemas";
  "local-sidecar" -> "schemas";
  "replay-proxy" -> "cli";
  "replay-proxy" -> "contracts";
  "replay-proxy" -> "local-sidecar";
  "replay-proxy" -> "schemas";
  "sdk-python" -> "local-sidecar";
  "sdk-python" -> "schemas";
  "sdk-typescript-sidecar-bundle" -> "sdk-typescript" [style=dashed];
}
